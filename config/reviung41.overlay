/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-demux";
        label = "KSCAN";
        polling-interval-msec = <25>;

        /* 디코더 입력 핀 (A0, A1, A2) */
        row-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH> // A0
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // A1
            , <&gpio0 2 GPIO_ACTIVE_HIGH>  // A2
            ;

        /* 컬럼 핀 18개 매칭 (알려주신 순서대로) */
        input-gpios
            = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // D13, D65, D85 매칭
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // NFC 핀
            , <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // NFC 핀
            , <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // P1.00
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> 
            , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // P1.04
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // P1.06
            , <&gpio1 7  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // P1.07
            , <&gpio1 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // P1.02
            , <&gpio1 1  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // P1.01
            ;
    };
};
